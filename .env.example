# Публичный адрес сайта (для canonical, sitemap, OG). На Vercel — ваш домен.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Концепт-режим: плашка «демо», noindex, форма без отправки. false — боевой режим.
NEXT_PUBLIC_DEMO_MODE=true

# Заявки в Telegram. Обязательны при NEXT_PUBLIC_DEMO_MODE=false, иначе форма вернёт 503.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
